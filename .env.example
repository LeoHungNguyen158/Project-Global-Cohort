# Copy to .env.local for development. Never commit real values.
# Browser-visible (compiled into client bundles; changing them needs a rebuild):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key
# Direct Postgres connection for migrations/seed/admin scripts (not used by the web app at runtime).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Canonical public URL of this app (used for auth email redirects).
APP_BASE_URL=http://localhost:3000
# development | staging | production. Seeding is refused when production.
APP_ENV=development
# none | quarantine. "quarantine" holds uploads until an administrator releases them
# (use until a malware scanner is configured). No scanner is integrated by default.
UPLOAD_SCAN_MODE=none
# Seed password for synthetic sample accounts (development/staging only).
SEED_PASSWORD=

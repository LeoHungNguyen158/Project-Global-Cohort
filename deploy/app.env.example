# Runtime settings for the VPS container (docker-compose.yml). Copy to deploy/app.env on
# the server and fill in there. deploy/app.env is never committed. Names only here.

# Must match the build arguments used for the image.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical public URL, e.g. https://lms.example.org (used in auth email links).
APP_BASE_URL=
APP_ENV=production
# none | quarantine. No malware scanner is integrated. "none" accepts files that pass the
# type, size and signature checks; "quarantine" holds every upload until an
# administrator releases it in /admin (see docs/OPERATIONS.md).
UPLOAD_SCAN_MODE=none
# Only when the proxy does not forward the public host (comma-separated hosts).
SERVER_ACTIONS_ALLOWED_ORIGINS=
